<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.MyStarting" parent="Theme.DoraCryptoTools">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.DoraCryptoTools</item>
    </style>
    <style name="Theme.DoraCryptoTools" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <!-- 这是 EditText 在未获得焦点或未激活时的下划线颜色。 -->
        <item name="colorControlNormal">@color/gray</item>
        <!-- 这是 EditText 在获得焦点或激活时的下划线颜色。 -->
        <item name="colorControlActivated">@color/purple_200</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">
            @color/colorTransBg
        </item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">
            @android:style/Animation.Translucent
        </item>
    </style>
</resources>